apiVersion: v1
clusters:
- cluster:
    server: https://gravitywell.ocf.berkeley.edu:6443
    certificate-authority-data: 
  name: gravitywell
- cluster:
    server: https://dna.ocf.berkeley.edu:6443
    certificate-authority-data: 
  name: dna
contexts:
- context:
    cluster: gravitywell
    user: oidc-staging
  name: gravitywell
- context:
    cluster: dna
    user: oidc-prod
  name: dna
current-context: gravitywell
kind: Config
users:
- name: oidc-staging
  user:
    exec:
      apiVersion: client.authentication.k8s.io/v1
      args:
      - oidc-login
      - get-token
      - --oidc-issuer-url=https://idm.ocf.berkeley.edu/realms/ocf
      - --oidc-client-id=kubernetes-staging
      - --browser-command=curl-spnego
      command: kubectl
      env: null
      interactiveMode: Never
      provideClusterInfo: false
- name: oidc-prod
  user:
    exec:
      apiVersion: client.authentication.k8s.io/v1
      args:
      - oidc-login
      - get-token
      - --oidc-issuer-url=https://idm.ocf.berkeley.edu/realms/ocf
      - --oidc-client-id=kubernetes-prod
      - --browser-command=curl-spnego
      command: kubectl
      env: null
      interactiveMode: Never
      provideClusterInfo: false
